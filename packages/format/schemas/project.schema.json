{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 512
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "sheets": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,31}$"
      }
    },
    "defaults": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z]{1,4}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "footprint": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^[^\\s:\\p{Cc}\\p{Cf}]+:[^\\s:\\p{Cc}\\p{Cf}]+$"
          },
          "fields": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z]([A-Za-z0-9 _.-]*[A-Za-z0-9_.])?$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "dnp": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "sheets"
  ],
  "additionalProperties": false,
  "$id": "project.schema.json"
}
